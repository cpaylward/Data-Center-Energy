    "# Both files have a 3-row merged header; skip to the third row for column names\n",
    "def load_eiam(path):\n",
    "    df = pd.read_excel(path, sheet_name=0, header=2)\n",
    "    return df\n",
    "\n",
    "old = load_eiam(FILE_OLD)\n",
    "new = load_eiam(FILE_NEW)\n",
    "\n",
    "print(\"Old shape:\", old.shape)\n",
    "print(\"New shape:\", new.shape)\n",
    "old.head(3)\n",
    "\n",
    "# Rename the first four columns consistently across both files\n",
    "def rename_base_cols(df):\n",
    "    cols = list(df.columns)\n",
    "    cols[:4] = [\"year\", \"month\", \"state\", \"data_status\"]\n",
    "    df.columns = cols\n",
    "    return df\n",
    "\n",
    "old = rename_base_cols(old)\n",
    "new = rename_base_cols(new)\n",
    "\n",
    "df = pd.concat([old, new], ignore_index=True)\n",
    "df[\"year\"] = pd.to_numeric(df[\"year\"], errors=\"coerce\")\n",
    "df = df.dropna(subset=[\"year\"])\n",
    "df[\"year\"] = df[\"year\"].astype(int)\n",
    "\n",
    "print(\"Combined shape:\", df.shape)\n",
    "print(\"Year range:\", df['year'].min(), \"–\", df['year'].max())\n",
    "\n",
    "# The EIA file is wide: Revenue / Sales / Customers / Price for each sector\n",
    "# Column positions (0-indexed): residential price = col 7, commercial = 11, industrial = 15\n",
    "# We keep year, month, state, data_status + all four price columns\n",
    "price_cols = {\"year\": df.columns[0],\n",
    "              \"month\": df.columns[1],\n",
    "              \"state\": df.columns[2],\n",
    "              \"data_status\": df.columns[3],\n",
    "              \"res_price\": df.columns[7],\n",
    "              \"com_price\": df.columns[11],\n",
    "              \"ind_price\": df.columns[15],\n",
    "              \"total_price\": df.columns[-1]}\n",
    "\n",
    "df = df[list(price_cols.values())].copy()\n",
    "df.columns = list(price_cols.keys())\n",
    "#df.head()\n",
    "\n",
    "price_col_names = [\"res_price\", \"com_price\", \"ind_price\", \"total_price\"]\n",
    "\n",
    "df[price_col_names] = df[price_col_names].replace(\".\", np.nan)\n",
    "df[price_col_names] = df[price_col_names].apply(pd.to_numeric, errors=\"coerce\")\n",
    "\n",
    "print(\"Missing values per column:\")\n",
    "print(df[price_col_names].isna().sum())\n",
    "\n",
    "STATES = [\"VA\", \"MD\", \"NC\", \"TX\", \"CA\", \"US\"]\n",
    "\n",
    "df_states = df[df[\"state\"].isin(STATES)].copy()\n",
    "\n",
    "print(\"Filtered shape:\", df_states.shape)\n",
    "print(\"States included:\", sorted(df_states[\"state\"].unique()))\n",
    "\n",
    "df_states[\"date\"] = pd.to_datetime(\n",
    "    df_states[[\"year\", \"month\"]].assign(day=1)\n",
    ")\n",
    "\n",
    "df_states = df_states.sort_values([\"state\", \"date\"]).reset_index(drop=True)\n",
    "#df_states.head()\n",
    "\n"
